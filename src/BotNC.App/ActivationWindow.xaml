<Window x:Class="BotNC.App.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ativar PEXBOT" Width="748" Height="530"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" Foreground="#F1F6FF">
    <Window.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="#F1F6FF" />
            <Setter Property="CaretBrush" Value="#79BAFF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="Height" Value="47" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame" Background="#0D1B2D" BorderBrush="#38516F"
                                BorderThickness="1" CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#69B1FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="#F1F6FF" />
            <Setter Property="CaretBrush" Value="#79BAFF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="Height" Value="47" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Frame" Background="#0D1B2D" BorderBrush="#38516F"
                                BorderThickness="1" CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#69B1FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" CornerRadius="12" Background="#287FDE">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#3D9CF7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#1C69BB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Background" Value="#31465E" />
                                <Setter Property="Foreground" Value="#A1B4C9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="17">
        <Border CornerRadius="24" BorderBrush="#496B92" BorderThickness="1" Background="#101C2E">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.48" Color="#000000" />
            </Border.Effect>
        </Border>
        <Grid Margin="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="277" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="23,0,0,23">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#153E70" Offset="0" />
                        <GradientStop Color="#102B4F" Offset="0.45" />
                        <GradientStop Color="#0A192D" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="27,28,24,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/Brand/pexbot-mark.png" Width="55" Height="55" Stretch="Uniform" />
                        <StackPanel VerticalAlignment="Center" Margin="9,0,0,0">
                            <TextBlock Text="PEXBOT" FontSize="22" FontWeight="Bold" Foreground="#F3F8FF" />
                            <TextBlock Text="NIGHT CROWS" FontSize="10" FontWeight="SemiBold" Foreground="#A7CAEC" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="3,0,0,4">
                        <Border Width="44" Height="44" HorizontalAlignment="Left" CornerRadius="14"
                                Background="#2E79BF" Margin="0,0,0,22">
                            <TextBlock Text="✓" FontSize="25" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Seu acesso,&#10;no seu PC." FontSize="29" FontWeight="Bold"
                                   LineHeight="34" Foreground="White" />
                        <TextBlock Text="Ative uma vez e abra o bot normalmente nas próximas vezes, mesmo sem internet."
                                   TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                   Foreground="#AFC9E2" Margin="0,14,3,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#54DFB0" Margin="0,0,8,0" />
                        <TextBlock Text="ACESSO INDIVIDUAL" FontSize="10" FontWeight="Bold"
                                   Foreground="#A9D1F5" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Margin="37,30,34,29">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Content="×" Width="30" Height="30" Panel.ZIndex="2"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnClose"
                        Foreground="#D5E5F8" FontSize="18" Background="#263A52"
                        BorderBrush="#37536F" BorderThickness="1" Cursor="Hand" ToolTip="Fechar" />
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="PRIMEIRO ACESSO" FontSize="10" FontWeight="Bold"
                               Foreground="#81BDFF" Margin="0,0,0,9" />
                    <TextBlock Text="Ativar PEXBOT" FontSize="28" FontWeight="Bold" Foreground="#F4F8FF" />
                    <TextBlock Text="Use o login e a senha enviados pelo administrador."
                               FontSize="13" Foreground="#A2B5CD" Margin="0,8,0,23" TextWrapping="Wrap" />
                    <TextBlock Text="Usuário" FontSize="12" FontWeight="SemiBold"
                               Foreground="#D9E7F8" Margin="0,0,0,7" />
                    <TextBox x:Name="UsernameBox" Style="{StaticResource InputStyle}"
                             MaxLength="80" Margin="0,0,0,16" />
                    <TextBlock Text="Senha" FontSize="12" FontWeight="SemiBold"
                               Foreground="#D9E7F8" Margin="0,0,0,7" />
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordStyle}"
                                 Margin="0,0,0,9" />
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#FFB4B0"
                               FontSize="12" MinHeight="28" Margin="0,0,0,3" />
                    <Button x:Name="ActivateButton" Content="Ativar neste computador  →"
                            Style="{StaticResource ActionStyle}" Click="OnActivate" IsDefault="True" />
                    <TextBlock Text="Depois da ativação, o bot abrirá sem pedir a senha novamente."
                               FontSize="11" Foreground="#8297B1" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,15,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
