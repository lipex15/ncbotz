<Window x:Class="BotNC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PEXBOT"
        Icon="Assets/Brand/pexbot-mark.png"
        Width="1320" Height="850" MinWidth="1100" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Loaded="OnWindowLoaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#0B1425" BorderBrush="#263850" BorderThickness="0,0,1,0">
            <Grid Margin="20,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/Brand/pexbot-mark.png" Width="42" Height="42"
                           Stretch="Uniform" Margin="0,0,9,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PEXBOT" Foreground="#65CEFA"
                                   FontSize="26" FontWeight="Black" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Button x:Name="OverviewNavigationButton" Content="⌂   Visão geral"
                            HorizontalContentAlignment="Left" Background="#275796"
                            BorderThickness="0" Click="OnShowOverview" />
                    <TextBlock Text="ÁREAS" Foreground="#8299B7" FontSize="10"
                               FontWeight="Bold" Margin="13,24,0,9" />
                    <Button Content="◆   Sapheras" HorizontalContentAlignment="Left"
                            Background="#17283F" BorderThickness="0"
                            Click="OnShowSapheras" />
                    <Button Content="◆   T.A 2 / T.A 3" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Margin="0,4,0,0"
                            Click="OnShowFarm" />
                    <Button x:Name="UpdatesNavigationButton" Content="↻   Atualizações"
                            Margin="0,4,0,0" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0"
                            Click="OnShowUpdates" />
                </StackPanel>
                <StackPanel Grid.Row="4">
                    <Border Background="#0F1B29" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="BASE MODULAR" Foreground="#4E91FF"
                                       FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="Pronta para receber novos fluxos e funções."
                                       Foreground="#7F91A6" TextWrapping="Wrap"
                                       FontSize="11" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ApplicationVersionText" Text="PEXBOT" Foreground="#52647A"
                               FontSize="10" Margin="2,14,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="OverviewPanel" Grid.Column="1" Margin="28,22,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="*" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Visão geral" FontSize="27" FontWeight="Bold" />
                    <TextBlock Text="Automação visual do Night Crows"
                               Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <Border Grid.Column="1" x:Name="StatusBadge" Background="#142237"
                        BorderBrush="#2B4059" BorderThickness="1" CornerRadius="18"
                        Padding="16,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                 Fill="#7F91A6" Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusBadgeText" Text="PARADO"
                                   Foreground="#AFC0D2" FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.22*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="OverviewScrollViewer" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,0">
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="11" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Clientes e ciclo de farm" Foreground="#65CEFA"
                                       FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="Ative um cliente ou os dois. Quando ambos estiverem ativos, o Cliente 1 tem prioridade."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" Margin="0,5,0,18" />
                            <TextBlock Text="CLIENTES · T.A DE DESTINO · SAPHERAS" Style="{StaticResource FieldLabel}" />
                            <Grid Margin="0,7,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="85" />
                                    <ColumnDefinition Width="82" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="EnableClient1CheckBox" Content="Cliente 1"
                                          IsChecked="True" VerticalAlignment="Center"
                                          Checked="OnClient1EnabledChanged" Unchecked="OnClient1EnabledChanged" />
                                <ComboBox x:Name="Client1ComboBox" Grid.Column="1" Height="40"
                                          DisplayMemberPath="DisplayName" />
                                <ComboBox x:Name="Ta1ComboBox" Grid.Column="3" Height="40" />
                                <CheckBox x:Name="Client1SapherasCheckBox" Grid.Column="4"
                                          Content="Sapheras" IsChecked="True"
                                          VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="85" />
                                    <ColumnDefinition Width="82" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="EnableClient2CheckBox" Content="Cliente 2"
                                          IsChecked="False" VerticalAlignment="Center"
                                          Checked="OnClient2EnabledChanged" Unchecked="OnClient2EnabledChanged" />
                                <ComboBox x:Name="Client2ComboBox" Grid.Column="1" Height="40"
                                          DisplayMemberPath="DisplayName" />
                                <ComboBox x:Name="Ta2ComboBox" Grid.Column="3" Height="40" />
                                <CheckBox x:Name="Client2SapherasCheckBox" Grid.Column="4"
                                          Content="Sapheras" IsChecked="False"
                                          VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                            <Button x:Name="RefreshButton" Content="Atualizar clientes"
                                    HorizontalAlignment="Right" Margin="0,0,0,12"
                                    Click="OnRefreshClients" />
                            <Border Background="#111C29" BorderBrush="#2A3B4D" BorderThickness="1"
                                    CornerRadius="8" Padding="12" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="PONTO DE FARM PERSONALIZADO"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="Com o mapa aberto, capture o ponto exato. Quando ativa, substitui as três posições aleatórias."
                                               Foreground="#7F91A6" FontSize="10" TextWrapping="Wrap"
                                               Margin="0,4,0,9" />
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="145" />
                                            <ColumnDefinition Width="135" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Cliente 1" VerticalAlignment="Center" />
                                        <CheckBox x:Name="Client1CustomCoordinateCheckBox" Grid.Column="1"
                                                  Content="Usar personalizada" VerticalAlignment="Center"
                                                  Checked="OnCustomCoordinateModeChanged"
                                                  Unchecked="OnCustomCoordinateModeChanged" />
                                        <Button x:Name="CaptureClient1CoordinateButton" Grid.Column="2"
                                                Content="Capturar ponto" Padding="9,7" Margin="4,0,7,0"
                                                Click="OnCaptureClient1Coordinate" />
                                        <TextBlock x:Name="Client1CustomCoordinateText" Grid.Column="3"
                                                   Text="Não definida" Foreground="#9CB0C3"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="145" />
                                            <ColumnDefinition Width="135" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Cliente 2" VerticalAlignment="Center" />
                                        <CheckBox x:Name="Client2CustomCoordinateCheckBox" Grid.Column="1"
                                                  Content="Usar personalizada" VerticalAlignment="Center"
                                                  Checked="OnCustomCoordinateModeChanged"
                                                  Unchecked="OnCustomCoordinateModeChanged" />
                                        <Button x:Name="CaptureClient2CoordinateButton" Grid.Column="2"
                                                Content="Capturar ponto" Padding="9,7" Margin="4,0,7,0"
                                                Click="OnCaptureClient2Coordinate" />
                                        <TextBlock x:Name="Client2CustomCoordinateText" Grid.Column="3"
                                                   Text="Não definida" Foreground="#9CB0C3"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Grid x:Name="SapherasSettingsSection">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="HORÁRIO DE SAPHERAS" Style="{StaticResource FieldLabel}" />
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ScheduleTextBox" Height="40" />
                                        <Button Grid.Column="2" Content="Agora +5s"
                                                Click="OnUseNow" Padding="10,8" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PERMANÊNCIA (MIN)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="DurationTextBox" Height="40"
                                             Margin="0,7,0,0" Text="30" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="INÍCIO AUTOMÁTICO" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="Se faltar mais, começa nas T.A configuradas."
                                               Foreground="#9CB0C3" FontSize="11" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="DIRETO SE FALTAR ATÉ (MIN)"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="DirectSapherasWindowTextBox" Height="36"
                                             Margin="0,5,0,0" Text="10" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="TP ALEATÓRIO — SAPHERAS" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="TeleportKeyComboBox" Height="40"
                                              Margin="0,7,0,0" IsEditable="True" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TP DE EMERGÊNCIA — PVP" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="EmergencyTeleportKeyComboBox" Height="40"
                                              Margin="0,7,0,0" IsEditable="True" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="ANTI OVER KILL" Style="{StaticResource FieldLabel}"
                                       Margin="0,15,0,0" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="MORTES" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="DeathThresholdTextBox" Height="38"
                                             Margin="0,5,0,0" Text="3" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="EM (MIN)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="DeathWindowTextBox" Height="38"
                                             Margin="0,5,0,0" Text="30" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="AGENDA (MIN)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="AgendaDurationTextBox" Height="38"
                                             Margin="0,5,0,0" Text="60" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Sapheras tem prioridade máxima. Favoritos: farm na 1ª posição; teleporte opcional na 2ª."
                                       Foreground="#7F91A6" FontSize="11" Margin="0,10,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="11" Padding="20" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Etapas protegidas" FontSize="14" FontWeight="Bold" />
                            <UniformGrid Columns="2" Margin="0,13,0,0">
                                <TextBlock Text="✓ Janela selecionada" Foreground="#8EE0BD" Margin="0,4" />
                                <TextBlock Text="✓ Menu e masmorra" Foreground="#8EE0BD" Margin="0,4" />
                                <TextBlock Text="✓ Atalaia Erodida" Foreground="#8EE0BD" Margin="0,4" />
                                <TextBlock Text="✓ Caça automática" Foreground="#8EE0BD" Margin="0,4" />
                                <TextBlock Text="✓ Compra dentro da T.A" Foreground="#8EE0BD" Margin="0,4" />
                                <TextBlock Text="✓ Retorno após PvP" Foreground="#8EE0BD" Margin="0,4" />
                                <TextBlock Text="✓ Áudio separado por cliente" Foreground="#8EE0BD" Margin="0,4" />
                                <TextBlock Text="✓ Favorito com TP opcional" Foreground="#8EE0BD" Margin="0,4" />
                                <TextBlock Text="✓ Restauração após morte" Foreground="#8EE0BD" Margin="0,4" />
                                <TextBlock Text="✓ Anti Over Kill por cliente" Foreground="#8EE0BD" Margin="0,4" />
                            </UniformGrid>
                            <TextBlock Text="O ciclo permanece ativo até você pausar ou parar o bot."
                                       Foreground="#7F91A6" FontSize="11" TextWrapping="Wrap"
                                       Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="11" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Controle" Foreground="#65CEFA"
                                       FontSize="16" FontWeight="Bold" />
                            <TextBlock x:Name="CurrentStateText" Text="Bot parado"
                                       FontSize="18" FontWeight="SemiBold" Margin="0,15,0,0" />
                            <TextBlock x:Name="CurrentDetailText"
                                       Text="Configure o módulo e clique em Iniciar."
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,5,0,17" />
                            <Button x:Name="StartButton" Content="▶  Iniciar PEXBOT"
                                    Height="44" Background="#2475C5" BorderThickness="0" Click="OnStartBot" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="INICIAR DEPOIS DE (MIN)"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="StartDelayMinutesTextBox"
                                             Height="36" Margin="0,4,0,0" Text="10" />
                                </StackPanel>
                                <Button x:Name="ScheduleStartButton" Grid.Column="2"
                                        Content="Programar início" VerticalAlignment="Bottom"
                                        Padding="11,8" Click="OnScheduleStart" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PauseButton" Content="Pausar"
                                        Foreground="#DDE8F2" Opacity="0.45"
                                        IsHitTestVisible="False" Click="OnPauseResume" />
                                <Button x:Name="StopButton" Grid.Column="2" Content="Parar"
                                        Foreground="#FFDCE2" Opacity="0.45"
                                        IsHitTestVisible="False" Background="#49202A"
                                        BorderBrush="#7C3544" Click="OnStopBot" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="11" Padding="16">
                        <StackPanel>
                            <TextBlock Text="PROTEÇÃO AUTOMÁTICA" FontSize="11" FontWeight="Bold" />
                            <Grid Margin="0,11,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cliente 1" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" x:Name="Client1AudioStateText"
                                           Text="Aguardando início" Foreground="#7F91A6"
                                           FontWeight="SemiBold" />
                            </Grid>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cliente 2" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" x:Name="Client2AudioStateText"
                                           Text="Aguardando início" Foreground="#7F91A6"
                                           FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="4" Background="#101A2C"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="11" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="Atividade recente" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#AFC2DE" />
                                <Button Content="Limpar" HorizontalAlignment="Right"
                                        Padding="8,3" FontSize="10" Click="OnClearLog" />
                            </Grid>
                            <ListBox x:Name="LogListBox" Grid.Row="2"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#AFC0D8" FontFamily="Segoe UI" FontSize="11"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                   Margin="0,2,6,3" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <TextBlock Grid.Row="4" x:Name="DatabasePathText" Foreground="#52647A"
                       FontSize="10" TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid x:Name="UpdatesPanel" Grid.Column="1" Margin="28,22,28,24"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Atualizações" FontSize="27" FontWeight="Bold" />
                <TextBlock Text="Confira e instale novas versões do PEXBOT."
                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="11" Padding="24" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="VERSÃO INSTALADA" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="InstalledVersionText" FontSize="22" FontWeight="SemiBold"
                               Margin="0,8,0,20" />
                    <TextBlock x:Name="UpdateStatusText" Text="Clique para procurar uma atualização."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    <ProgressBar x:Name="UpdateProgressBar" Height="8" Margin="0,18,0,0"
                                 Minimum="0" Maximum="100" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button x:Name="CheckUpdatesButton" Content="Verificar atualizações"
                                Click="OnCheckForUpdates" />
                        <Button x:Name="InstallUpdateButton" Content="Baixar e instalar"
                                IsEnabled="False" Opacity="1" Margin="10,0,0,0" Background="#347EF2"
                                BorderThickness="0" Click="OnInstallUpdate">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="UpdateButtonBorder" Background="{TemplateBinding Background}"
                                            CornerRadius="3" Padding="16,10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="UpdateButtonBorder" Property="Background" Value="#25394E" />
                                            <Setter Property="Foreground" Value="#9CB0C3" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="A instalação preserva suas configurações e fecha o bot antes de atualizar."
                               Foreground="{StaticResource MutedBrush}" FontSize="11"
                               Margin="0,24,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
