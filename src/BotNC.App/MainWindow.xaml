                            <TextBlock Text="Cliente 1" FontSize="17" FontWeight="SemiBold" Foreground="#65CEFA" />
                            <CheckBox x:Name="Client1AnonymousCheckBox" Content="Farm individual na Anônima" Margin="0,13,0,10" />
                            <CheckBox x:Name="Client1AnonymousCustomCheckBox" Content="Ponto personalizado · individual e Agenda" />
                            <Button x:Name="CaptureClient1AnonymousButton" Content="Capturar ponto no mapa" Click="OnCaptureClient1AnonymousCoordinate" Margin="0,6,0,4" />
                            <TextBlock x:Name="Client1AnonymousCoordinateText" Text="Não definida" Margin="0,0,0,10" />
                            <TextBlock Text="NÍVEL DA MASMORRA" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="Client1IndividualDungeonComboBox" SelectedIndex="1" Height="40" Margin="0,6,0,12">
                                <ComboBoxItem Content="Nível 86" /><ComboBoxItem Content="Nível 97" /><ComboBoxItem Content="Nível 110" />
                            </ComboBox>
                            <TextBlock Text="LIMITE SEMANAL DE ENTRADAS · SOMENTE INDIVIDUAL" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="Client1AnonymousLimitTextBox" Text="1" Width="110" Height="42" HorizontalAlignment="Left" Margin="0,6,0,12" />
                            <Border Height="1" Background="#30445B" Margin="0,22,0,22" />
                            <TextBlock Text="Cliente 2" FontSize="17" FontWeight="SemiBold" Foreground="#65CEFA" />
                            <CheckBox x:Name="Client2AnonymousCheckBox" Content="Farm individual na Anônima" Margin="0,13,0,10" />
                            <CheckBox x:Name="Client2AnonymousCustomCheckBox" Content="Ponto personalizado · individual e Agenda" />
                            <Button x:Name="CaptureClient2AnonymousButton" Content="Capturar ponto no mapa" Click="OnCaptureClient2AnonymousCoordinate" Margin="0,6,0,4" />
                            <TextBlock x:Name="Client2AnonymousCoordinateText" Text="Não definida" Margin="0,0,0,10" />
                            <TextBlock Text="NÍVEL DA MASMORRA" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="Client2IndividualDungeonComboBox" SelectedIndex="1" Height="40" Margin="0,6,0,12">
                                <ComboBoxItem Content="Nível 86" /><ComboBoxItem Content="Nível 97" /><ComboBoxItem Content="Nível 110" />
                            </ComboBox>
                            <TextBlock Text="LIMITE SEMANAL DE ENTRADAS · SOMENTE INDIVIDUAL" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="Client2AnonymousLimitTextBox" Text="1" Width="110" Height="42" HorizontalAlignment="Left" Margin="0,6,0,12" />
                        </StackPanel>
                    </Border>
                    </Grid>
                    <TextBlock Text="Escolha uma masmorra individual por cliente. Para fazer as duas em sequência, use a Agenda. Os limites individuais são separados e reiniciam segunda às 04:00; a Agenda não tem limite de entradas. A Agenda habilitada tem prioridade sobre o modo individual."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="3,18,0,14" />
                    <Button Content="Organizar sequência na Agenda" HorizontalAlignment="Right" Click="OnShowFarmSchedule" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="ProtectionPanel" Grid.Column="1" Margin="28,22,28,24" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Proteção" FontSize="27" FontWeight="Bold" />
                <TextBlock Text="Defina quando entrar em Agenda após mortes repetidas."
                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="22" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Anti Over Kill" Foreground="#65CEFA" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="ATIVAR PARA" Style="{StaticResource FieldLabel}" Margin="0,13,0,5" />
                    <ComboBox x:Name="AntiOverkillScopeComboBox" Width="180" Height="40"
                              HorizontalAlignment="Left" Margin="0,0,0,12" />
                    <TextBlock Text="Após o número definido de mortes dentro da janela, o personagem entra em Agenda pelo tempo escolhido."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,18" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="MORTES" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="DeathThresholdTextBox" Height="40" Margin="0,7,0,0" Text="3" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="JANELA (MIN)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="DeathWindowTextBox" Height="40" Margin="0,7,0,0" Text="30" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="AGENDA (MIN)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="AgendaDurationTextBox" Height="40" Margin="0,7,0,0" Text="60" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="FarmSchedulePanel" Grid.Column="1" Margin="28,22,28,24" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Agenda de farm" FontSize="27" FontWeight="Bold" />
                <TextBlock Text="Organize destinos e duração. Proteções e rotinas prioritárias pausam a etapa e depois retomam o plano."
                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardContainer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Plano sequencial" Foreground="#65CEFA" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Execute Abadia, Estreito de Tenerys e T.A 1 na ordem escolhida. A T.A 1 usa seu ponto capturado, sem Favoritos. Ao concluir, retorna à T.A configurada."
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,20,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="USAR AGENDA PARA" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                                <ComboBox x:Name="FarmScheduleScopeComboBox" Width="180" Height="40" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid x:Name="FarmScheduleEditorGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardContainer}">
                            <StackPanel>
                                <TextBlock Text="Cliente 1" Foreground="#65CEFA" FontSize="17" FontWeight="SemiBold" />
                                <Grid Margin="0,14,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="Client1ScheduleDestinationComboBox" Height="40" SelectionChanged="OnScheduleDestinationChanged" />
                                    <TextBox x:Name="Client1ScheduleDurationTextBox" Grid.Column="2" Height="40" Text="60" />
                                    <ComboBox x:Name="Client1AnonymousLevelComboBox" Grid.Column="4" Height="40" ToolTip="Nível do Estreito" />
                                    <Button Grid.Column="6" Content="Adicionar" Click="OnAddClient1ScheduleStep" />
                                </Grid>
                                <TextBlock Text="DESTINO · DURAÇÃO EM MINUTOS" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
                                <ListBox x:Name="Client1ScheduleListBox" MinHeight="90" MaxHeight="210"
                                         ItemsSource="{Binding Client1ScheduleSteps}" DisplayMemberPath="DisplayText"
                                         Background="#0E1726" BorderBrush="#2A405D" Padding="5" />
                                <TextBlock x:Name="Client1ScheduleTotalText" Text="Tempo total: 0 min" Margin="0,9,0,0" Foreground="#AFC2D9" />
                                <TextBlock x:Name="Client1ScheduleLiveText" TextWrapping="Wrap" Foreground="#65CEFA" Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="Subir" Padding="12,7" Click="OnMoveClient1ScheduleUp" />
                                    <Button Content="Descer" Padding="12,7" Margin="7,0,0,0" Click="OnMoveClient1ScheduleDown" />
                                    <Button Content="Remover" Padding="12,7" Margin="7,0,0,0" Click="OnRemoveClient1ScheduleStep" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardContainer}">
                            <StackPanel>
                                <TextBlock Text="Cliente 2" Foreground="#65CEFA" FontSize="17" FontWeight="SemiBold" />
                                <Grid Margin="0,14,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="Client2ScheduleDestinationComboBox" Height="40" SelectionChanged="OnScheduleDestinationChanged" />
                                    <TextBox x:Name="Client2ScheduleDurationTextBox" Grid.Column="2" Height="40" Text="60" />
                                    <ComboBox x:Name="Client2AnonymousLevelComboBox" Grid.Column="4" Height="40" ToolTip="Nível do Estreito" />
                                    <Button Grid.Column="6" Content="Adicionar" Click="OnAddClient2ScheduleStep" />
                                </Grid>
                                <TextBlock Text="DESTINO · DURAÇÃO EM MINUTOS" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
                                <ListBox x:Name="Client2ScheduleListBox" MinHeight="90" MaxHeight="210"
                                         ItemsSource="{Binding Client2ScheduleSteps}" DisplayMemberPath="DisplayText"
                                         Background="#0E1726" BorderBrush="#2A405D" Padding="5" />
                                <TextBlock x:Name="Client2ScheduleTotalText" Text="Tempo total: 0 min" Margin="0,9,0,0" Foreground="#AFC2D9" />
                                <TextBlock x:Name="Client2ScheduleLiveText" TextWrapping="Wrap" Foreground="#65CEFA" Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="Subir" Padding="12,7" Click="OnMoveClient2ScheduleUp" />
                                    <Button Content="Descer" Padding="12,7" Margin="7,0,0,0" Click="OnMoveClient2ScheduleDown" />
                                    <Button Content="Remover" Padding="12,7" Margin="7,0,0,0" Click="OnRemoveClient2ScheduleStep" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource CardContainer}" Background="#102035">
                        <StackPanel>
                            <TextBlock Text="A Agenda não limita entradas. O tempo só é consumido durante o farm na masmorra da etapa. Fora dela, a contagem pausa. Ao acabar a Agenda ou o tempo disponível da masmorra, segue para a T.A configurada."
                                       Foreground="#AFC2D9" TextWrapping="Wrap" />
                            <Button Content="Salvar agenda" Width="150" HorizontalAlignment="Right" Margin="0,12,0,0" Click="OnSaveFarmSchedule" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="UpdatesPanel" Grid.Column="1" Margin="28,22,28,24"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Atualizações" FontSize="27" FontWeight="Bold" />
                <TextBlock x:Name="UpdatesIntroText" Text="Confira e instale novas versões do PEXBOT."
                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="24" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="VERSÃO INSTALADA" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="InstalledVersionText" FontSize="22" FontWeight="SemiBold"
                               Margin="0,8,0,20" />
                    <TextBlock x:Name="UpdateStatusText" Text="Clique para procurar uma atualização."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    <ProgressBar x:Name="UpdateProgressBar" Height="8" Margin="0,18,0,0"
                                 Minimum="0" Maximum="100" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button x:Name="CheckUpdatesButton" Content="Verificar atualizações"
                                Click="OnCheckForUpdates" />
                        <Button x:Name="InstallUpdateButton" Content="Baixar e instalar"
                                IsEnabled="False" Opacity="1" Margin="10,0,0,0" Background="#347EF2"
                                BorderThickness="0" Click="OnInstallUpdate">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="UpdateButtonBorder" Background="{TemplateBinding Background}"
                                            CornerRadius="3" Padding="16,10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="UpdateButtonBorder" Property="Background" Value="#25394E" />
                                            <Setter Property="Foreground" Value="#9CB0C3" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="A instalação preserva suas configurações e fecha o bot antes de atualizar."
                               Foreground="{StaticResource MutedBrush}" FontSize="11"
                               Margin="0,24,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="ExpandedLogOverlay" Grid.Column="1" Panel.ZIndex="90" Background="#081020" Visibility="Collapsed" Margin="28,22,28,24">
            <Border CornerRadius="24" Background="#122238" Padding="24" BorderBrush="#35516B" BorderThickness="1">
                <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,18">
                        <Button DockPanel.Dock="Right" Content="Salvar arquivo" Click="OnSaveDiagnostic" />
                        <Button x:Name="TechnicalCopyLogButton" DockPanel.Dock="Right" Content="Copiar diagnóstico" Click="OnCopyLog" Margin="0,0,12,0" />
                        <TextBlock Text="Diagnóstico" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                      <TextBlock Grid.Row="1" Text="Registros técnicos para resolver problemas. A tela mostra as últimas 1.500 linhas; copiar ou salvar inclui toda a execução."
                                 TextWrapping="Wrap" Foreground="#9BB5D5" FontSize="12" Margin="0,0,0,12"/>
                      <TextBox x:Name="TechnicalLogText" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap"
                             Background="#0C192B" Foreground="#E1ECF7" BorderThickness="0" Padding="12"
                             FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="StartPreviewOverlay" Grid.ColumnSpan="2" Grid.RowSpan="2" Panel.ZIndex="100"
              Background="#C0081020" Visibility="Collapsed">
            <Border Width="620" Padding="30" CornerRadius="24" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#14263D" BorderBrush="#3C6888" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Vamos começar?" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="Confira o que será executado nesta sessão." Foreground="#B7C9DE" Margin="0,8,0,20" />
                    <Border Background="#0C1B2E" CornerRadius="22" Padding="18">
                        <TextBlock x:Name="StartPreviewText" TextWrapping="Wrap" LineHeight="25" Foreground="#DFEBF8" />
                    </Border>
                    <TextBlock Text="O progresso é salvo durante a execução. Acompanhe cada cliente na Visão geral; você pode pausar ou parar a qualquer momento."
                               TextWrapping="Wrap" Foreground="#ADC3D8" Margin="0,18,0,22" />
                    <CheckBox x:Name="SkipStartPreviewCheckBox" Content="Não mostrar novamente"
                              FontSize="11" Foreground="#ADC3D8" Margin="0,0,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Content="Voltar às configurações" Click="OnCancelStartPreview" />
                        <Button Grid.Column="2" Content="▶  Iniciar agora" Background="#237DC6" Click="OnConfirmStartPreview" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
