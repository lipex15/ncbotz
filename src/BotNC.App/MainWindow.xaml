<Window x:Class="BotNC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PEXBOT"
        Icon="Assets/Brand/pexbot-mark.png"
        Width="1320" Height="850" MinWidth="1100" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI"
        Loaded="OnWindowLoaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#0B1425" BorderBrush="#263850" BorderThickness="0,0,1,0">
            <Grid Margin="20,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/Brand/pexbot-mark.png" Width="42" Height="42"
                           Stretch="Uniform" Margin="0,0,9,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="AppNameText" Text="PEXBOT" Foreground="#65CEFA"
                                   FontSize="26" FontWeight="Black" />
                        <TextBlock x:Name="TestChannelBadge" Text="AMBIENTE DE TESTES"
                                   Foreground="#F7C66C" FontSize="9" FontWeight="Bold"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Button x:Name="OverviewNavigationButton" Content="🏠   Visão geral"
                            HorizontalContentAlignment="Left" Background="#275796"
                            BorderThickness="0" Click="OnShowOverview" />
                    <TextBlock Text="ÁREAS" Foreground="#8299B7" FontSize="10"
                               FontWeight="Bold" Margin="13,24,0,9" />
                    <Button Content="⛏️   Sapheras" HorizontalContentAlignment="Left"
                            Background="#17283F" BorderThickness="0"
                            Click="OnShowSapheras" />
                    <Button Content="🗺️   T.A 1 / T.A 2 / T.A 3" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Margin="0,4,0,0"
                            Click="OnShowFarm" />
                    <Button x:Name="AbbeyNavigationButton" Content="🏰   Abadia / Anônima" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Margin="0,4,0,0"
                            Click="OnShowAbbey" />
                    <Button x:Name="RoutinesNavigationButton" Content="📋   Rotinas diárias" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Margin="0,4,0,0"
                            Click="OnShowRoutines" />
                    <Button x:Name="FarmScheduleNavigationButton" Content="📅   Agenda de farm" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Margin="0,4,0,0"
                            Click="OnShowFarmSchedule" />
                    <Button x:Name="ProtectionNavigationButton" Content="🛡️   Proteção" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Margin="0,4,0,0"
                            Click="OnShowProtection" />
                    <Button x:Name="UpdatesNavigationButton"
                            Margin="0,4,0,0" HorizontalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="0"
                            Click="OnShowUpdates">
                        <Grid>
                            <TextBlock Text="🔔   Atualizações" VerticalAlignment="Center" />
                            <Ellipse x:Name="UpdatesNotificationDot" Width="9" Height="9"
                                     Fill="#FF4D67" HorizontalAlignment="Right"
                                     VerticalAlignment="Center" Visibility="Collapsed">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#FF3557" BlurRadius="9" ShadowDepth="0" Opacity="0.85" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                    </Button>
                </StackPanel>
                <Border Grid.Row="3" x:Name="RunIndicator" VerticalAlignment="Bottom" Margin="0,20,0,20"
                        Padding="14" CornerRadius="22" Background="#102B30" BorderBrush="#27625A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="RunIndicatorTitle" Text="Pronto para começar" Foreground="#75E4BD" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="RunElapsedText" Text="Selecione seus clientes e rotinas" Foreground="#B1C8D4" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <ProgressBar x:Name="RunPulse" IsIndeterminate="True" Height="3" Margin="0,12,0,0" Foreground="#45D8A5" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="4">
                    <TextBlock x:Name="ApplicationVersionText" Text="PEXBOT" Foreground="#52647A"
                               FontSize="10" Margin="2,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="OverviewPanel" Grid.Column="1" Margin="28,22,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="*" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Visão geral" FontSize="27" FontWeight="Bold" />
                    <TextBlock Text="Automação visual do Night Crows"
                               Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <Border Grid.Column="1" x:Name="StatusBadge" Background="#142237"
                        BorderBrush="#2B4059" BorderThickness="1" CornerRadius="18"
                        Padding="16,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                 Fill="#7F91A6" Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusBadgeText" Text="PARADO"
                                   Foreground="#AFC0D2" FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.22*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="OverviewScrollViewer" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,0">
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="28" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Clientes e ciclo de farm" Foreground="#65CEFA"
                                       FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="Ative um cliente ou os dois. Quando ambos estiverem ativos, o Cliente 1 tem prioridade."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" Margin="0,5,0,18" />
                            <TextBlock x:Name="ConfigurationLockHint" Text="🔒 Configuração desta sessão · pare a execução para editar"
                                       Foreground="#79DAB6" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12" Visibility="Collapsed" />
                            <TextBlock Text="CLIENTES · T.A (FARM OU RESERVA) · SAPHERAS" Style="{StaticResource FieldLabel}" />
                            <Grid Margin="0,7,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition Width="82" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="EnableClient1CheckBox" Content="Cliente 1"
                                          IsChecked="True" VerticalAlignment="Center"
                                          Checked="OnClient1EnabledChanged" Unchecked="OnClient1EnabledChanged" />
                                <ComboBox x:Name="Client1ComboBox" Grid.Column="1" Height="40"
                                          DisplayMemberPath="DisplayName" />
                                <ComboBox x:Name="Ta1ComboBox" Grid.Column="3" Height="40" SelectionChanged="OnTaDestinationChanged" />
                                <CheckBox x:Name="Client1SapherasCheckBox" Grid.Column="4"
                                          Content="Sapheras" IsChecked="True"
                                          VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition Width="82" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="EnableClient2CheckBox" Content="Cliente 2"
                                          IsChecked="False" VerticalAlignment="Center"
                                          Checked="OnClient2EnabledChanged" Unchecked="OnClient2EnabledChanged" />
                                <ComboBox x:Name="Client2ComboBox" Grid.Column="1" Height="40"
                                          DisplayMemberPath="DisplayName" />
                                <ComboBox x:Name="Ta2ComboBox" Grid.Column="3" Height="40" SelectionChanged="OnTaDestinationChanged" />
                                <CheckBox x:Name="Client2SapherasCheckBox" Grid.Column="4"
                                          Content="Sapheras" IsChecked="False"
                                          VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                            <Button Content="Sapheras: Ambos" HorizontalAlignment="Right" Margin="0,0,0,8"
                                    Padding="9,5" Click="OnSelectBothSapheras" />
                            <Button x:Name="RefreshButton" Content="Atualizar clientes"
                                    HorizontalAlignment="Right" Margin="0,0,0,12"
                                    Click="OnRefreshClients" />
                            <Border Background="#111C29" BorderBrush="#2A3B4D" BorderThickness="1"
                                    CornerRadius="20" Padding="12" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="PONTO DE FARM PERSONALIZADO"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="Com o mapa aberto, capture o ponto exato. Na T.A 1 (Codex), use o mapa no zoom mínimo; o ponto é obrigatório."
                                               Foreground="#7F91A6" FontSize="10" TextWrapping="Wrap"
                                               Margin="0,4,0,9" />
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="145" />
                                            <ColumnDefinition Width="135" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Cliente 1" VerticalAlignment="Center" />
                                        <CheckBox x:Name="Client1CustomCoordinateCheckBox" Grid.Column="1"
                                                  Content="Usar personalizada" VerticalAlignment="Center"
                                                  Checked="OnCustomCoordinateModeChanged"
                                                  Unchecked="OnCustomCoordinateModeChanged" />
                                        <Button x:Name="CaptureClient1CoordinateButton" Grid.Column="2"
                                                Content="Capturar ponto" Padding="9,7" Margin="4,0,7,0"
                                                Click="OnCaptureClient1Coordinate" />
                                        <TextBlock x:Name="Client1CustomCoordinateText" Grid.Column="3"
                                                   Text="Não definida" Foreground="#9CB0C3"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="145" />
                                            <ColumnDefinition Width="135" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Cliente 2" VerticalAlignment="Center" />
                                        <CheckBox x:Name="Client2CustomCoordinateCheckBox" Grid.Column="1"
                                                  Content="Usar personalizada" VerticalAlignment="Center"
                                                  Checked="OnCustomCoordinateModeChanged"
                                                  Unchecked="OnCustomCoordinateModeChanged" />
                                        <Button x:Name="CaptureClient2CoordinateButton" Grid.Column="2"
                                                Content="Capturar ponto" Padding="9,7" Margin="4,0,7,0"
                                                Click="OnCaptureClient2Coordinate" />
                                        <TextBlock x:Name="Client2CustomCoordinateText" Grid.Column="3"
                                                   Text="Não definida" Foreground="#9CB0C3"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Grid x:Name="SapherasSettingsSection">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="HORÁRIO DE SAPHERAS" Style="{StaticResource FieldLabel}" />
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ScheduleTextBox" Height="40" />
                                        <Button Grid.Column="2" Content="Agora +5s"
                                                Click="OnUseNow" Padding="10,8" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PERMANÊNCIA (MIN)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="DurationTextBox" Height="40"
                                             Margin="0,7,0,0" Text="30" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="INÍCIO AUTOMÁTICO" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="Se faltar mais, começa no destino de farm configurado."
                                               Foreground="#9CB0C3" FontSize="11" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="DIRETO SE FALTAR ATÉ (MIN)"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="DirectSapherasWindowTextBox" Height="36"
                                             Margin="0,5,0,0" Text="10" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="TP ALEATÓRIO — SAPHERAS" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="TeleportKeyComboBox" Height="40"
                                              Margin="0,7,0,0" IsEditable="True" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TP DE EMERGÊNCIA — PVP" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="EmergencyTeleportKeyComboBox" Height="40"
                                              Margin="0,7,0,0" IsEditable="True" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Sapheras tem prioridade apenas nos clientes em que estiver habilitada e exige passe. Favoritos: farm na 1ª posição; teleporte opcional na 2ª."
                                       Foreground="#7F91A6" FontSize="11" Margin="0,10,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="28" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Sua execução" Foreground="#65CEFA"
                                       FontSize="16" FontWeight="Bold" />
                            <TextBlock x:Name="CurrentStateText" Text="Bot parado"
                                       FontSize="18" FontWeight="SemiBold" Margin="0,15,0,0" />
                            <TextBlock x:Name="CurrentDetailText"
                                       Text="Configure o módulo e clique em Iniciar."
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,5,0,17" />
                            <Button x:Name="StartButton" Content="▶  Iniciar PEXBOT"
                                    Height="48" Background="#2475C5" BorderThickness="0" Click="OnPreviewStart" />
                            <Button x:Name="RestoreStartPreviewButton" Content="Mostrar resumo ao iniciar"
                                    Visibility="Collapsed" HorizontalAlignment="Right" FontSize="10" Padding="4,3"
                                    Background="Transparent" BorderThickness="0" Foreground="#9CB7CF"
                                    Click="OnRestoreStartPreview" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="INICIAR DEPOIS DE (MIN)"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="StartDelayMinutesTextBox"
                                             Height="36" Margin="0,4,0,0" Text="0" />
                                </StackPanel>
                                <Button x:Name="ScheduleStartButton" Grid.Column="2"
                                        Content="Programar início" VerticalAlignment="Bottom"
                                        Padding="11,8" Click="OnScheduleStart" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PauseButton" Content="Pausar"
                                        Foreground="#DDE8F2" Opacity="0.45"
                                        IsHitTestVisible="False" Click="OnPauseResume" />
                                <Button x:Name="StopButton" Grid.Column="2" Content="Parar"
                                        Foreground="#FFDCE2" Opacity="0.45"
                                        IsHitTestVisible="False" Background="#49202A"
                                        BorderBrush="#7C3544" Click="OnStopBot" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="28" Padding="16">
                        <StackPanel>
                            <TextBlock Text="CLIENTES EM TEMPO REAL" FontSize="11" FontWeight="Bold" />
                            <Grid Margin="0,11,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cliente 1" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" x:Name="Client1AudioStateText"
                                           Text="Aguardando início" Foreground="#7F91A6"
                                           FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock x:Name="Client1ActivityText" Text="Aguardando início" FontSize="11" Foreground="#B7C9DE" TextWrapping="Wrap" MaxHeight="48" Margin="0,6,0,8" />
                            <TextBlock x:Name="Client1AgendaLiveText" Foreground="#65CEFA" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10" />
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cliente 2" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" x:Name="Client2AudioStateText"
                                           Text="Aguardando início" Foreground="#7F91A6"
                                           FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock x:Name="Client2ActivityText" Text="Aguardando início" FontSize="11" Foreground="#B7C9DE" TextWrapping="Wrap" MaxHeight="48" Margin="0,6,0,0" />
                            <TextBlock x:Name="Client2AgendaLiveText" Foreground="#65CEFA" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="4" Background="#101A2C"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="28" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="Atividade recente" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#AFC2DE" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Técnico" Padding="8,3" FontSize="10" Margin="0,0,7,0" Click="OnExpandLog" />
                                    <Button x:Name="CopyLogButton" Content="Copiar diagnóstico" Margin="0,0,7,0"
                                            Padding="8,3" FontSize="10" Click="OnCopyLog" />
                                    <Button Content="Limpar" Padding="8,3" FontSize="10" Click="OnClearLog" />
                                </StackPanel>
                            </Grid>
                            <ListBox x:Name="LogListBox" Grid.Row="2"
                                     Visibility="Visible" HorizontalContentAlignment="Stretch"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#AFC0D8" FontFamily="Segoe UI" FontSize="11"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Background="#14263B" Padding="10" Margin="0,3,4,4">
                                            <StackPanel>
                                                <DockPanel><TextBlock Text="{Binding Time}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#849AB4" FontSize="10"/>
                                                    <TextBlock Text="{Binding Client}" Foreground="{Binding Tone}" FontWeight="SemiBold" FontSize="10"/></DockPanel>
                                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#E1ECF7" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <TextBlock Grid.Row="4" x:Name="DatabasePathText" Foreground="#52647A"
                       FontSize="10" TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid x:Name="RoutinesPanel" Grid.Column="1" Margin="28,22,28,24" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Rotinas" FontSize="27" FontWeight="Bold" />
                <TextBlock Text="Atividades programadas por cliente, respeitando a prioridade de Sapheras."
                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="28" Padding="20" Margin="0,0,7,14">
                        <StackPanel>
                            <TextBlock Text="Missões Diárias" Foreground="#65CEFA" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="EXECUTAR PARA" Style="{StaticResource FieldLabel}" Margin="0,13,0,5" />
                            <ComboBox x:Name="DailyMissionsScopeComboBox" Width="180" Height="40"
                                      HorizontalAlignment="Left" Margin="0,0,0,12" />
                            <TextBlock Text="HORÁRIO DE EXECUÇÃO" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="DailyMissionsTimeTextBox" Text="04:05" Width="150" Height="40"
                                     HorizontalAlignment="Left" Margin="0,7,0,0" />
                            <TextBlock Text="O ciclo diário redefine às 04:00. O bot aceita tudo, abre a missão roxa, teleporta e inicia Campanha automática."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="28" Padding="20" Margin="7,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Diretivas de Guilda" Foreground="#65CEFA" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="EXECUTAR PARA" Style="{StaticResource FieldLabel}" Margin="0,13,0,5" />
                            <ComboBox x:Name="GuildDirectiveScopeComboBox" Width="180" Height="40"
                                      HorizontalAlignment="Left" Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="HORÁRIO DE EXECUÇÃO" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="GuildDirectiveTimeTextBox" Text="04:05" Height="40" Margin="0,7,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="LOCAL DA DIRETIVA" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="GuildDirectiveAreaComboBox" Height="40" Margin="0,7,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Ao aceitar, o jogo conclui as cinco diretivas do local escolhido. Mapa Aberto é combinado com as Diárias."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="28" Padding="20" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Correio de recursos" Foreground="#65CEFA" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Resgatar as entregas das 01:00 e 07:00 para os clientes escolhidos."
                                       Foreground="{StaticResource MutedBrush}" Margin="0,7,0,12" />
                            <ComboBox x:Name="MailScopeComboBox" Width="180" Height="40" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="28" Padding="20" Margin="7,0,0,14">
                        <StackPanel>
                            <StackPanel>
                                <TextBlock Text="Compra diária na Loja" Foreground="#65CEFA" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Compra Comum e Invocação; o novo ciclo começa às 13:01."
                                           Foreground="{StaticResource MutedBrush}" Margin="0,7,0,12" TextWrapping="Wrap" />
                                <ComboBox x:Name="DailyShopScopeComboBox" Width="180" Height="40" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="HORÁRIO" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="DailyShopTimeTextBox" Text="13:05" Width="150" Height="40" HorizontalAlignment="Left" Margin="0,7,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="28" Padding="20" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="Boss do Amor · Trashi" Foreground="#65CEFA"
                                       FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="FAZER PARA" Style="{StaticResource FieldLabel}" Margin="0,13,0,5" />
                            <ComboBox x:Name="LoveBossScopeComboBox" Width="180" Height="40"
                                      HorizontalAlignment="Left" />
                            <TextBlock Text="Entradas às 09:00, 12:00, 16:00, 20:00 e 00:00 (UTC−3). O bot tenta entrar cerca de 2 minutos antes, uma vez por dia e no máximo 5 vezes por semana para cada cliente."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Margin="0,12,0,0" />
                            <TextBlock Text="Interrompe o farm na T.A ou masmorra, confirma a vitória, resgata a recompensa e retoma a rota. Sapheras mantém prioridade."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="28" Padding="20" Margin="0,0,7,14">
                        <StackPanel>
                            <TextBlock Text="Check-in e doações da Guilda" Foreground="#65CEFA" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Check-in e até 3 doações de 10.000 ouro. Nunca usa Morion ou diamantes. Reinicia à 00:00 (UTC−3)."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,12" />
                            <TextBlock Text="EXECUTAR PARA" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="GuildCheckinScopeComboBox" Width="180" Height="40" HorizontalAlignment="Left" Margin="0,7,0,12" />
                            <TextBlock Text="HORÁRIO DE EXECUÇÃO" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="GuildCheckinTimeTextBox" Text="00:05" Width="150" Height="40" HorizontalAlignment="Left" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="AbbeyPanel" Grid.Column="1" Margin="28,22,28,24" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Abadia / Masmorra Anônima" FontSize="27" FontWeight="Bold" />
                <TextBlock Text="Abadia da Lembrança e Estreito de Tenerys; Sapheras continua prioritária."
                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="28" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Abadia da Lembrança" FontSize="21" FontWeight="Bold" />
                            <TextBlock Text="Farm individual com ponto opcional" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,16" />
                            <TextBlock Text="Cliente 1" FontSize="17" FontWeight="SemiBold" Foreground="#65CEFA" />
                            <CheckBox x:Name="Client1AbbeyCheckBox" Content="Farm individual na Abadia"
                                      Margin="0,13,0,10" />
                            <TextBlock Text="LIMITE SEMANAL DE ENTRADAS · SOMENTE INDIVIDUAL" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="Client1AbbeyLimitTextBox" Text="1" Width="110" Height="38"
                                     HorizontalAlignment="Left" Margin="0,6,0,12" />
                            <CheckBox x:Name="Client1AbbeyCustomCheckBox" Content="Usar ponto personalizado na Abadia" />
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <Button x:Name="CaptureClient1AbbeyButton" Content="Capturar ponto no mapa"
                                        Click="OnCaptureClient1AbbeyCoordinate" />
                                <TextBlock x:Name="Client1AbbeyCoordinateText" Text="Não definida"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                            <Border Height="1" Background="#30445B" Margin="0,22,0,22" />
                            <TextBlock Text="Cliente 2" FontSize="17" FontWeight="SemiBold" Foreground="#65CEFA" />
                            <CheckBox x:Name="Client2AbbeyCheckBox" Content="Farm individual na Abadia"
                                      Margin="0,13,0,10" />
                            <TextBlock Text="LIMITE SEMANAL DE ENTRADAS · SOMENTE INDIVIDUAL" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="Client2AbbeyLimitTextBox" Text="1" Width="110" Height="38"
                                     HorizontalAlignment="Left" Margin="0,6,0,12" />
                            <CheckBox x:Name="Client2AbbeyCustomCheckBox" Content="Usar ponto personalizado na Abadia" />
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <Button x:Name="CaptureClient2AbbeyButton" Content="Capturar ponto no mapa"
                                        Click="OnCaptureClient2AbbeyCoordinate" />
                                <TextBlock x:Name="Client2AbbeyCoordinateText" Text="Não definida"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="28" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Masmorra Anônima" FontSize="21" FontWeight="Bold" />
                            <TextBlock Text="Estreito de Tenerys" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,16" />
                            <TextBlock Text="Cliente 1" FontSize="17" FontWeight="SemiBold" Foreground="#65CEFA" />
                            <CheckBox x:Name="Client1AnonymousCheckBox" Content="Farm individual na Anônima" Margin="0,13,0,10" />
                            <TextBlock Text="NÍVEL DA MASMORRA" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="Client1IndividualDungeonComboBox" SelectedIndex="1" Height="40" Margin="0,6,0,12">
                                <ComboBoxItem Content="Nível 86" /><ComboBoxItem Content="Nível 97" /><ComboBoxItem Content="Nível 110" />
                            </ComboBox>
                            <TextBlock Text="LIMITE SEMANAL DE ENTRADAS · SOMENTE INDIVIDUAL" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="Client1AnonymousLimitTextBox" Text="1" Width="110" Height="38" HorizontalAlignment="Left" Margin="0,6,0,12" />
                            <Border Height="1" Background="#30445B" Margin="0,22,0,22" />
                            <TextBlock Text="Cliente 2" FontSize="17" FontWeight="SemiBold" Foreground="#65CEFA" />
                            <CheckBox x:Name="Client2AnonymousCheckBox" Content="Farm individual na Anônima" Margin="0,13,0,10" />
                            <TextBlock Text="NÍVEL DA MASMORRA" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="Client2IndividualDungeonComboBox" SelectedIndex="1" Height="40" Margin="0,6,0,12">
                                <ComboBoxItem Content="Nível 86" /><ComboBoxItem Content="Nível 97" /><ComboBoxItem Content="Nível 110" />
                            </ComboBox>
                            <TextBlock Text="LIMITE SEMANAL DE ENTRADAS · SOMENTE INDIVIDUAL" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="Client2AnonymousLimitTextBox" Text="1" Width="110" Height="38" HorizontalAlignment="Left" Margin="0,6,0,12" />
                        </StackPanel>
                    </Border>
                    </Grid>
                    <TextBlock Text="Escolha uma masmorra individual por cliente. Para fazer as duas em sequência, use a Agenda. Os limites individuais são separados e reiniciam segunda às 04:00; a Agenda não tem limite de entradas. A Agenda habilitada tem prioridade sobre o modo individual."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="3,18,0,14" />
                    <Button Content="Organizar sequência na Agenda" HorizontalAlignment="Right" Click="OnShowFarmSchedule" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="ProtectionPanel" Grid.Column="1" Margin="28,22,28,24" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Proteção" FontSize="27" FontWeight="Bold" />
                <TextBlock Text="Defina quando entrar em Agenda após mortes repetidas."
                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="28" Padding="22" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Anti Over Kill" Foreground="#65CEFA" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="ATIVAR PARA" Style="{StaticResource FieldLabel}" Margin="0,13,0,5" />
                    <ComboBox x:Name="AntiOverkillScopeComboBox" Width="180" Height="40"
                              HorizontalAlignment="Left" Margin="0,0,0,12" />
                    <TextBlock Text="Após o número definido de mortes dentro da janela, o personagem entra em Agenda pelo tempo escolhido."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,18" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="MORTES" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="DeathThresholdTextBox" Height="40" Margin="0,7,0,0" Text="3" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="JANELA (MIN)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="DeathWindowTextBox" Height="40" Margin="0,7,0,0" Text="30" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="AGENDA (MIN)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="AgendaDurationTextBox" Height="40" Margin="0,7,0,0" Text="60" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="FarmSchedulePanel" Grid.Column="1" Margin="28,22,28,24" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Agenda de farm" FontSize="27" FontWeight="Bold" />
                <TextBlock Text="Organize destinos e duração. Proteções e rotinas prioritárias pausam a etapa e depois retomam o plano."
                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardContainer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Plano sequencial" Foreground="#65CEFA" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Execute Abadia e Estreito de Tenerys na ordem escolhida. Ao concluir, o cliente retorna à T.A configurada."
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,20,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="USAR AGENDA PARA" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                                <ComboBox x:Name="FarmScheduleScopeComboBox" Width="180" Height="40" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid x:Name="FarmScheduleEditorGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardContainer}">
                            <StackPanel>
                                <TextBlock Text="Cliente 1" Foreground="#65CEFA" FontSize="17" FontWeight="SemiBold" />
                                <Grid Margin="0,14,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="Client1ScheduleDestinationComboBox" Height="40" SelectionChanged="OnScheduleDestinationChanged" />
                                    <TextBox x:Name="Client1ScheduleDurationTextBox" Grid.Column="2" Height="40" Text="60" />
                                    <ComboBox x:Name="Client1AnonymousLevelComboBox" Grid.Column="4" Height="40" ToolTip="Nível do Estreito" />
                                    <Button Grid.Column="6" Content="Adicionar" Click="OnAddClient1ScheduleStep" />
                                </Grid>
                                <TextBlock Text="DESTINO · DURAÇÃO EM MINUTOS" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
                                <ListBox x:Name="Client1ScheduleListBox" MinHeight="150" MaxHeight="260"
                                         ItemsSource="{Binding Client1ScheduleSteps}" DisplayMemberPath="DisplayText"
                                         Background="#0E1726" BorderBrush="#2A405D" Padding="5" />
                                <TextBlock x:Name="Client1ScheduleTotalText" Text="Tempo total: 0 min" Margin="0,9,0,0" Foreground="#AFC2D9" />
                                <TextBlock x:Name="Client1ScheduleLiveText" TextWrapping="Wrap" Foreground="#65CEFA" Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="Subir" Padding="12,7" Click="OnMoveClient1ScheduleUp" />
                                    <Button Content="Descer" Padding="12,7" Margin="7,0,0,0" Click="OnMoveClient1ScheduleDown" />
                                    <Button Content="Remover" Padding="12,7" Margin="7,0,0,0" Click="OnRemoveClient1ScheduleStep" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardContainer}">
                            <StackPanel>
                                <TextBlock Text="Cliente 2" Foreground="#65CEFA" FontSize="17" FontWeight="SemiBold" />
                                <Grid Margin="0,14,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="Client2ScheduleDestinationComboBox" Height="40" SelectionChanged="OnScheduleDestinationChanged" />
                                    <TextBox x:Name="Client2ScheduleDurationTextBox" Grid.Column="2" Height="40" Text="60" />
                                    <ComboBox x:Name="Client2AnonymousLevelComboBox" Grid.Column="4" Height="40" ToolTip="Nível do Estreito" />
                                    <Button Grid.Column="6" Content="Adicionar" Click="OnAddClient2ScheduleStep" />
                                </Grid>
                                <TextBlock Text="DESTINO · DURAÇÃO EM MINUTOS" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
                                <ListBox x:Name="Client2ScheduleListBox" MinHeight="150" MaxHeight="260"
                                         ItemsSource="{Binding Client2ScheduleSteps}" DisplayMemberPath="DisplayText"
                                         Background="#0E1726" BorderBrush="#2A405D" Padding="5" />
                                <TextBlock x:Name="Client2ScheduleTotalText" Text="Tempo total: 0 min" Margin="0,9,0,0" Foreground="#AFC2D9" />
                                <TextBlock x:Name="Client2ScheduleLiveText" TextWrapping="Wrap" Foreground="#65CEFA" Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="Subir" Padding="12,7" Click="OnMoveClient2ScheduleUp" />
                                    <Button Content="Descer" Padding="12,7" Margin="7,0,0,0" Click="OnMoveClient2ScheduleDown" />
                                    <Button Content="Remover" Padding="12,7" Margin="7,0,0,0" Click="OnRemoveClient2ScheduleStep" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource CardContainer}" Background="#102035">
                        <StackPanel>
                            <TextBlock Text="A Agenda não limita entradas. O tempo só é consumido durante o farm na masmorra da etapa. Fora dela, a contagem pausa. Ao acabar a Agenda ou o tempo disponível da masmorra, segue para a T.A configurada."
                                       Foreground="#AFC2D9" TextWrapping="Wrap" />
                            <Button Content="Salvar agenda" Width="150" HorizontalAlignment="Right" Margin="0,12,0,0" Click="OnSaveFarmSchedule" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="UpdatesPanel" Grid.Column="1" Margin="28,22,28,24"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Atualizações" FontSize="27" FontWeight="Bold" />
                <TextBlock x:Name="UpdatesIntroText" Text="Confira e instale novas versões do PEXBOT."
                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="28" Padding="24" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="VERSÃO INSTALADA" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="InstalledVersionText" FontSize="22" FontWeight="SemiBold"
                               Margin="0,8,0,20" />
                    <TextBlock x:Name="UpdateStatusText" Text="Clique para procurar uma atualização."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    <ProgressBar x:Name="UpdateProgressBar" Height="8" Margin="0,18,0,0"
                                 Minimum="0" Maximum="100" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button x:Name="CheckUpdatesButton" Content="Verificar atualizações"
                                Click="OnCheckForUpdates" />
                        <Button x:Name="InstallUpdateButton" Content="Baixar e instalar"
                                IsEnabled="False" Opacity="1" Margin="10,0,0,0" Background="#347EF2"
                                BorderThickness="0" Click="OnInstallUpdate">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="UpdateButtonBorder" Background="{TemplateBinding Background}"
                                            CornerRadius="3" Padding="16,10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="UpdateButtonBorder" Property="Background" Value="#25394E" />
                                            <Setter Property="Foreground" Value="#9CB0C3" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="A instalação preserva suas configurações e fecha o bot antes de atualizar."
                               Foreground="{StaticResource MutedBrush}" FontSize="11"
                               Margin="0,24,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="ExpandedLogOverlay" Grid.ColumnSpan="2" Panel.ZIndex="90" Background="#EE081020" Visibility="Collapsed" Margin="16">
            <Border CornerRadius="24" Background="#122238" Padding="24" BorderBrush="#35516B" BorderThickness="1">
                <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,18">
                        <Button DockPanel.Dock="Right" Content="Fechar" Click="OnCloseExpandedLog" />
                          <Button x:Name="TechnicalCopyLogButton" DockPanel.Dock="Right" Content="Copiar log completo" Click="OnCopyLog" Margin="0,0,12,0" />
                        <Button DockPanel.Dock="Right" Content="Atualizar" Click="OnExpandLog" Margin="0,0,12,0" />
                        <TextBlock Text="Diagnóstico técnico" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                      <TextBlock Grid.Row="1" Text="Exibindo as últimas 1.500 linhas. Copiar log completo inclui toda a execução, sem cortar o diagnóstico."
                                 TextWrapping="Wrap" Foreground="#9BB5D5" FontSize="12" Margin="0,0,0,12"/>
                      <TextBox x:Name="TechnicalLogText" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap"
                             Background="#0C192B" Foreground="#E1ECF7" BorderThickness="0" Padding="12"
                             FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="StartPreviewOverlay" Grid.ColumnSpan="2" Panel.ZIndex="100"
              Background="#C0081020" Visibility="Collapsed">
            <Border Width="620" Padding="30" CornerRadius="24" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#14263D" BorderBrush="#3C6888" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Vamos começar?" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="Confira o que será executado nesta sessão." Foreground="#B7C9DE" Margin="0,8,0,20" />
                    <Border Background="#0C1B2E" CornerRadius="22" Padding="18">
                        <TextBlock x:Name="StartPreviewText" TextWrapping="Wrap" LineHeight="25" Foreground="#DFEBF8" />
                    </Border>
                    <TextBlock Text="O progresso é salvo durante a execução. Acompanhe cada cliente na Visão geral; você pode pausar ou parar a qualquer momento."
                               TextWrapping="Wrap" Foreground="#ADC3D8" Margin="0,18,0,22" />
                    <CheckBox x:Name="SkipStartPreviewCheckBox" Content="Não mostrar novamente"
                              FontSize="11" Foreground="#ADC3D8" Margin="0,0,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Content="Voltar às configurações" Click="OnCancelStartPreview" />
                        <Button Grid.Column="2" Content="▶  Iniciar agora" Background="#237DC6" Click="OnConfirmStartPreview" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
