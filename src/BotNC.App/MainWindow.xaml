<Window x:Class="BotNC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BotNC.App"
        Title="PEXBOT"
        Icon="Assets/Brand/pexbot-mark.png"
        Width="1320" Height="850" MinWidth="1100" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI" FontSize="14"
        Loaded="OnWindowLoaded">
    <Window.Resources>
<Geometry x:Key="IconOverview">M2,10 L12,2 22,10 M5,8 L5,22 10,22 10,15 15,15 15,22 20,22 20,8</Geometry>
<Geometry x:Key="IconStatistics">M3,22 L3,14 6,14 6,22 Z M10,22 L10,8 13,8 13,22 Z M17,22 L17,2 20,2 20,22 Z</Geometry>
<Geometry x:Key="IconSapheras">M12,1 L22,11 12,23 2,11 Z M12,1 L8,11 12,23 16,11 Z M2,11 L22,11</Geometry>
<Geometry x:Key="IconTa">M12,23 C9,18 3,13 3,9 C3,-1 21,-1 21,9 C21,13 15,18 12,23 Z M12,6 A3,3 0 1 0 12,12 A3,3 0 1 0 12,6</Geometry>
<Geometry x:Key="IconAbbey">M2,8 L12,2 22,8 Z M4,11 L4,20 M9,11 L9,20 M15,11 L15,20 M20,11 L20,20 M2,23 L22,23</Geometry>
<Geometry x:Key="IconFarmSchedule">M3,5 L21,5 21,22 3,22 Z M3,10 L21,10 M7,1 L7,7 M17,1 L17,7 M7,14 L10,14 M14,14 L17,14 M7,18 L10,18</Geometry>
<Geometry x:Key="IconRoutines">M5,4 L19,4 19,22 5,22 Z M9,2 L15,2 15,6 9,6 Z M8,11 L10,13 14,9 M8,18 L16,18</Geometry>
<Geometry x:Key="IconProtection">M12,2 L22,6 20,16 12,23 4,16 2,6 Z M12,6 L12,18</Geometry>
<Geometry x:Key="IconDiagnostics">M2,3 L22,3 22,21 2,21 Z M4,13 L8,13 10,7 14,17 16,11 20,11</Geometry>
<Geometry x:Key="IconUpdates">M3,10 A9,9 0 0 1 20,6 M20,1 L20,7 14,7 M21,14 A9,9 0 0 1 4,18 M4,23 L4,17 10,17</Geometry>

<Style x:Key="NeonNavigation" TargetType="Button">
<Setter Property="Foreground" Value="#B3C6DE"/><Setter Property="Cursor" Value="Hand"/>
<Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Height" Value="37"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
<Border Background="{TemplateBinding Background}" CornerRadius="8"><Grid>
<Border x:Name="ActiveLine" Width="2" Background="#26DAEE" HorizontalAlignment="Left" Margin="0,7" Visibility="Collapsed"/>
<Grid Margin="15,0"><Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition Width="13"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Path Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.65" Stretch="Uniform" Width="21" Height="21" StrokeLineJoin="Round"/>
<ContentPresenter Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left"/>
</Grid></Grid></Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#45DBED"/></Trigger>
<DataTrigger Binding="{Binding Background.Color, RelativeSource={RelativeSource TemplatedParent}}"><DataTrigger.Value><Color>#153D50</Color></DataTrigger.Value><Setter TargetName="ActiveLine" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="#53E1F2"/></DataTrigger>
</ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="FarmSwitch" TargetType="CheckBox">
<Setter Property="Foreground" Value="#BCD0E3"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal">
<ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0"/>
<Border x:Name="Track" Width="43" Height="24" CornerRadius="12" Background="#3B4757" BorderBrush="#566477" BorderThickness="1">
<Ellipse x:Name="Knob" Width="18" Height="18" Fill="#BDCAD8" HorizontalAlignment="Left" Margin="2"/>
</Border></StackPanel><ControlTemplate.Triggers>
<Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#08ADC6"/><Setter TargetName="Track" Property="BorderBrush" Value="#2CD5EB"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Fill" Value="#F2FCFF"/></Trigger>
<Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65"/></Trigger>
<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="White"/></Trigger>
</ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>

<Style x:Key="CompactCard" TargetType="Border">
<Setter Property="Background" Value="{StaticResource CardBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="18"/>
</Style>
<Style x:Key="DiscreetHelp" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6,0,0"/><Setter Property="LineHeight" Value="17"/></Style>
        <Style x:Key="OverviewExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          HorizontalContentAlignment="Stretch" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderSurface" Background="Transparent" CornerRadius="8" Padding="3,4">
                                            <DockPanel>
                                                <TextBlock x:Name="Chevron" Text="＋" DockPanel.Dock="Right" Foreground="#65CEFA" FontSize="18" Margin="12,0,0,0" />
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="−" /></Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="#20344D" /></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="#20344D" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="0,12,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.RowSpan="2" Background="#0B1425" BorderBrush="#263850" BorderThickness="0,0,1,0">
            <Grid Margin="14,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="55" Height="60" Margin="0,0,10,0"><Canvas Width="70" Height="74">
<Path Stroke="#22D7F2" StrokeThickness="1.6" Fill="#0C2B3D" Data="M7,55 L27,29 20,29 39,13 51,9 64,12 55,19 65,19 52,27 47,42 32,64 34,47 20,62 25,45 Z"/>
<Path Stroke="#34DDF5" StrokeThickness="1.6" Data="M12,48 L31,32 M23,24 L41,18 M38,16 L51,14 M29,42 L40,32 M40,29 L45,24"/>
<Path Fill="#8CF4FF" Data="M48,15 L53,15 49,18 Z"/>
</Canvas></Viewbox>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="AppNameText" Text="PEXBOT" Foreground="#65CEFA"
                                   FontSize="27" FontWeight="SemiBold" />
                        <TextBlock Text="N I G H T  C R O W S" FontSize="9" Foreground="#32CEE9" Margin="0,3,0,4"/>
                        <TextBlock x:Name="TestChannelBadge" Text="AMBIENTE DE TESTES"
                                   Foreground="#F7C66C" FontSize="9" FontWeight="Bold"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Button x:Name="OverviewNavigationButton" Style="{StaticResource NeonNavigation}" Tag="{StaticResource IconOverview}" Content="Início"
                            HorizontalContentAlignment="Left" Background="#153D50"
                            BorderThickness="0" Click="OnShowOverview" />
                    <Button x:Name="StatisticsNavigationButton" Style="{StaticResource NeonNavigation}" Tag="{StaticResource IconStatistics}" Content="Estatísticas" Click="OnShowStatistics"
                            Visibility="Collapsed" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Margin="0,4,0,0"/>
                    <TextBlock Text="FARM" Foreground="#8299B7" FontSize="10"
                               FontWeight="Normal" Margin="15,12,0,7" />
                    <Button x:Name="SapherasNavigationButton" Style="{StaticResource NeonNavigation}" Tag="{StaticResource IconSapheras}" Content="Sapheras" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0"
                            Click="OnShowSapheras" />
                    <Button x:Name="TaNavigationButton" Style="{StaticResource NeonNavigation}" Tag="{StaticResource IconTa}" Content="Terra Avassaladora" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Margin="0,4,0,0"
                            Click="OnShowFarm" />
                    <Button x:Name="AbbeyNavigationButton" Style="{StaticResource NeonNavigation}" Tag="{StaticResource IconAbbey}" Content="Abadia / Anônima" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Margin="0,4,0,0"
                            Click="OnShowAbbey" />
                    <Button x:Name="FarmScheduleNavigationButton" Style="{StaticResource NeonNavigation}" Tag="{StaticResource IconFarmSchedule}" Content="Agenda de farm" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Margin="0,4,0,0"
                            Click="OnShowFarmSchedule" />
                    <TextBlock Text="AUTOMAÇÃO" Foreground="#8299B7" FontSize="10"
                               FontWeight="Bold" Margin="13,12,0,7" />
                    <Button x:Name="RoutinesNavigationButton" Style="{StaticResource NeonNavigation}" Tag="{StaticResource IconRoutines}" Content="Rotinas diárias" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Margin="0,4,0,0"
                            Click="OnShowRoutines" />
                    <Button x:Name="ProtectionNavigationButton" Style="{StaticResource NeonNavigation}" Tag="{StaticResource IconProtection}" Content="Proteção" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Margin="0,4,0,0"
                            Click="OnShowProtection" />
                    <Button x:Name="DiagnosticsNavigationButton" Style="{StaticResource NeonNavigation}" Tag="{StaticResource IconDiagnostics}" Content="Diagnóstico" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Margin="0,8,0,0" Click="OnExpandLog" />
                    <Button x:Name="UpdatesNavigationButton" Style="{StaticResource NeonNavigation}" Tag="{StaticResource IconUpdates}"
                            Margin="0,16,0,0" HorizontalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="0"
                            Click="OnShowUpdates">
                        <Grid>
                            <TextBlock Text="Atualizações" FontSize="15" VerticalAlignment="Center" />
                            <Ellipse x:Name="UpdatesNotificationDot" Width="9" Height="9"
                                     Fill="#FF4D67" HorizontalAlignment="Right"
                                     VerticalAlignment="Center" Visibility="Collapsed">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#FF3557" BlurRadius="9" ShadowDepth="0" Opacity="0.85" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                    </Button>
                </StackPanel>
                <Border Grid.Row="4" x:Name="RunIndicator" VerticalAlignment="Bottom" Margin="0,8,0,8"
                        Padding="14" CornerRadius="22" Background="#102B30" BorderBrush="#27625A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="RunIndicatorTitle" Text="Pronto para começar" Foreground="#75E4BD" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="RunElapsedText" Text="Selecione seus clientes e rotinas" Foreground="#B1C8D4" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <ProgressBar x:Name="RunPulse" IsIndeterminate="True" Height="3" Margin="0,12,0,0" Foreground="#45D8A5" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="5">
                    <TextBlock x:Name="ApplicationVersionText" Text="PEXBOT" Foreground="#52647A"
                               FontSize="10" Margin="2,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Canvas Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Width="300" Height="54" IsHitTestVisible="False" ClipToBounds="True" Opacity="0.5">
<Path Stroke="#124459" StrokeThickness="1" Data="M60,0 L5,54 M105,0 L50,54 M135,0 L80,54 M195,0 L140,54 M220,0 L165,54 M260,0 L205,54"/>
<Path Stroke="#16DAF3" StrokeThickness="4" Data="M165,0 L132,33"><Path.Effect><DropShadowEffect Color="#00D9FF" BlurRadius="15" ShadowDepth="0" Opacity="0.85"/></Path.Effect></Path>
</Canvas>
        <local:StatisticsPanel x:Name="UserStatisticsPanel" Grid.Column="1" Margin="28,22,28,24" Visibility="Collapsed"/>
        <Grid x:Name="OverviewPanel" Grid.Column="1" Margin="28,22,28,18">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><StackPanel><TextBlock Text="Início" FontSize="34" FontWeight="Bold"/><TextBlock Text="Suas contas, seus destinos. Configure e deixe o farm seguir." Style="{StaticResource DiscreetHelp}"/></StackPanel>
<Button x:Name="RefreshButton" Content="↻  Atualizar clientes" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnRefreshClients" Background="#0D1C2A" BorderBrush="#39BFD7" Padding="14,9"/></Grid>
<ScrollViewer x:Name="OverviewScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<StackPanel Margin="0,0,6,0">
<TextBlock x:Name="ConfigurationLockHint" Text="Configuração da sessão · pare a execução para editar." Style="{StaticResource DiscreetHelp}" Foreground="#79DAB6" Visibility="Collapsed"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" VerticalAlignment="Top" Style="{StaticResource CompactCard}"><StackPanel>
<CheckBox x:Name="EnableClient1CheckBox" Content="Cliente 1" FontSize="18" FontWeight="SemiBold" IsChecked="True" Checked="OnClient1EnabledChanged" Unchecked="OnClient1EnabledChanged"/>
<TextBlock Text="Selecione o cliente" Foreground="#B5C6DC" FontSize="14" Margin="0,16,0,6"/>
<ComboBox x:Name="Client1ComboBox" DisplayMemberPath="DisplayName" Height="42"/>
<TextBlock Text="Selecione a janela correspondente a esta conta." Style="{StaticResource DiscreetHelp}"/>
<TextBlock Text="Destino de farm" Foreground="#B5C6DC" FontSize="14" Margin="0,12,0,6"/>
<ComboBox x:Name="Ta1ComboBox" Height="42" SelectionChanged="OnTaDestinationChanged"/>
<TextBlock Text="Pontos e favoritos são configurados na aba Terra Avassaladora." Style="{StaticResource DiscreetHelp}"/>
<Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,15,0,12"/>
<WrapPanel>
<CheckBox x:Name="Client1SapherasCheckBox" Style="{StaticResource FarmSwitch}" Content="Sapheras" IsChecked="True" Margin="0,0,20,0"/>
<CheckBox x:Name="Client1KeepRestCheckBox" Style="{StaticResource FarmSwitch}" Content="Modo descanso" IsChecked="True"/>
</WrapPanel>
<TextBlock Text="Sapheras segue o horário configurado. Descanso desligado mantém o farm com a tela aberta." Style="{StaticResource DiscreetHelp}"/>
</StackPanel></Border><Border Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource CompactCard}"><StackPanel>
<CheckBox x:Name="EnableClient2CheckBox" Content="Cliente 2" FontSize="18" FontWeight="SemiBold" IsChecked="False" Checked="OnClient2EnabledChanged" Unchecked="OnClient2EnabledChanged"/>
<TextBlock Text="Selecione o cliente" Foreground="#B5C6DC" FontSize="14" Margin="0,16,0,6"/>
<ComboBox x:Name="Client2ComboBox" DisplayMemberPath="DisplayName" Height="42"/>
<TextBlock Text="Selecione a janela correspondente a esta conta." Style="{StaticResource DiscreetHelp}"/>
<TextBlock Text="Destino de farm" Foreground="#B5C6DC" FontSize="14" Margin="0,12,0,6"/>
<ComboBox x:Name="Ta2ComboBox" Height="42" SelectionChanged="OnTaDestinationChanged"/>
<TextBlock Text="Pontos e favoritos são configurados na aba Terra Avassaladora." Style="{StaticResource DiscreetHelp}"/>
<Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,15,0,12"/>
<WrapPanel>
<CheckBox x:Name="Client2SapherasCheckBox" Style="{StaticResource FarmSwitch}" Content="Sapheras" IsChecked="False" Margin="0,0,20,0"/>
<CheckBox x:Name="Client2KeepRestCheckBox" Style="{StaticResource FarmSwitch}" Content="Modo descanso" IsChecked="True"/>
</WrapPanel>
<TextBlock Text="Sapheras segue o horário configurado. Descanso desligado mantém o farm com a tela aberta." Style="{StaticResource DiscreetHelp}"/>
</StackPanel></Border></Grid>
<Border Margin="0,14,0,0" Style="{StaticResource CompactCard}"><StackPanel><TextBlock Text="Acontecendo agora" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0">
<DockPanel><TextBlock Text="Cliente 1" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBlock x:Name="Client1AudioStateText" Text="Aguardando início" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/></DockPanel>
<TextBlock x:Name="Client1ActivityText" Text="Aguardando início" Style="{StaticResource DiscreetHelp}" MaxHeight="48"/>
<TextBlock x:Name="Client1AgendaLiveText" Foreground="#65CEFA" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
</StackPanel><StackPanel Grid.Column="2">
<DockPanel><TextBlock Text="Cliente 2" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBlock x:Name="Client2AudioStateText" Text="Aguardando início" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/></DockPanel>
<TextBlock x:Name="Client2ActivityText" Text="Aguardando início" Style="{StaticResource DiscreetHelp}" MaxHeight="48"/>
<TextBlock x:Name="Client2AgendaLiveText" Foreground="#65CEFA" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
</StackPanel></Grid></StackPanel></Border>
<TextBlock Text="Durante o farm, a vigilância é em segundo plano. A janela só é acionada quando uma ação é necessária." Style="{StaticResource DiscreetHelp}"/>
<Border  Background="#101A2C" Visibility="Collapsed"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="16" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="Atividade recente" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#AFC2DE" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Técnico" Padding="8,3" FontSize="10" Margin="0,0,7,0" Click="OnExpandLog" />
                                    <Button x:Name="CopyLogButton" Content="Copiar diagnóstico" Margin="0,0,7,0"
                                            Padding="8,3" FontSize="10" Click="OnCopyLog" />
                                    <Button Content="Limpar" Padding="8,3" FontSize="10" Click="OnClearLog" />
                                </StackPanel>
                            </Grid>
                            <ListBox x:Name="LogListBox" Grid.Row="2"
                                     Visibility="Visible" HorizontalContentAlignment="Stretch"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#AFC0D8" FontFamily="Segoe UI" FontSize="11"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Background="#14263B" Padding="10" Margin="0,3,4,4">
                                            <StackPanel>
                                                <DockPanel><TextBlock Text="{Binding Time}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#849AB4" FontSize="10"/>
                                                    <TextBlock Text="{Binding Client}" Foreground="{Binding Tone}" FontWeight="SemiBold" FontSize="10"/></DockPanel>
                                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#E1ECF7" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
</StackPanel></ScrollViewer>
<TextBlock x:Name="DatabasePathText" Grid.Row="3" FontSize="9" Foreground="#52647A" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
</Grid>
<Grid x:Name="TaSettingsPanel" Grid.Column="1" Margin="28,22,28,18" Visibility="Collapsed">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Terra Avassaladora" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Configure o ponto de cada cliente para o destino escolhido. T.A 1, T.A 2 e T.A 3 mantêm pontos separados." Style="{StaticResource DiscreetHelp}"/></StackPanel>
<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,6,0"><Border  Style="{StaticResource CompactCard}"><StackPanel><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0"><TextBlock Text="CLIENTE 1 · DESTINO" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/><ComboBox Height="42" ItemsSource="{Binding ItemsSource, ElementName=Ta1ComboBox}" SelectedItem="{Binding SelectedItem, ElementName=Ta1ComboBox, Mode=TwoWay}" IsEnabled="{Binding IsEnabled, ElementName=Ta1ComboBox}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="CLIENTE 2 · DESTINO" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/><ComboBox Height="42" ItemsSource="{Binding ItemsSource, ElementName=Ta2ComboBox}" SelectedItem="{Binding SelectedItem, ElementName=Ta2ComboBox, Mode=TwoWay}" IsEnabled="{Binding IsEnabled, ElementName=Ta2ComboBox}"/></StackPanel></Grid>
<Border Background="#111C29" BorderBrush="#2A3B4D" BorderThickness="1"
                                    CornerRadius="20" Padding="12" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="PONTO DE FARM PERSONALIZADO"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="Com o mapa aberto, capture o ponto exato. Na T.A 1 (Codex), use o mapa no zoom mínimo; o ponto é obrigatório."
                                               Foreground="#7F91A6" FontSize="10" TextWrapping="Wrap"
                                               Margin="0,4,0,9" />
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="145" />
                                            <ColumnDefinition Width="135" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Cliente 1" VerticalAlignment="Center" />
                                        <CheckBox x:Name="Client1CustomCoordinateCheckBox" Grid.Column="1"
                                                  Content="Usar personalizada" VerticalAlignment="Center"
                                                  Checked="OnCustomCoordinateModeChanged"
                                                  Unchecked="OnCustomCoordinateModeChanged" />
                                        <Button x:Name="CaptureClient1CoordinateButton" Grid.Column="2"
                                                Content="Capturar ponto" Padding="9,7" Margin="4,0,7,0"
                                                Click="OnCaptureClient1Coordinate" />
                                        <TextBlock x:Name="Client1CustomCoordinateText" Grid.Column="3"
                                                   Text="Não definida" Foreground="#9CB0C3"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="145" />
                                            <ColumnDefinition Width="135" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Cliente 2" VerticalAlignment="Center" />
                                        <CheckBox x:Name="Client2CustomCoordinateCheckBox" Grid.Column="1"
                                                  Content="Usar personalizada" VerticalAlignment="Center"
                                                  Checked="OnCustomCoordinateModeChanged"
