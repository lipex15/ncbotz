<UserControl x:Class="BotNC.App.StatisticsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsVisibleChanged="OnVisibilityChanged">
    <UserControl.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#122238"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="BorderBrush" Value="#293E57"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="29"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,6"/>
            <Setter Property="Foreground" Value="#F0F5FD"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A4B8CE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,0">
            <TextBlock Text="ESTATÍSTICAS · SEU PROGRESSO" FontSize="10" FontWeight="Bold" Foreground="#65CEFA"/>
            <TextBlock x:Name="Greeting" Text="Seu progresso, de perto" FontSize="28" FontWeight="Bold" Margin="0,6,0,6" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource Hint}" Text="Resultados observados pelo bot. Cada cliente tem seu próprio histórico, salvo entre reinícios."/>
            <Border Background="#0F1D2F" CornerRadius="18" Padding="16,12" Margin="0,16,12,18">
                <Expander Header="Personalizar nomes" Foreground="#A4B8CE">
                <StackPanel Margin="0,14,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="NICK · CLIENTE 1" Style="{StaticResource Hint}"/><TextBox x:Name="Nick1" MaxLength="40" Margin="0,6,0,0" ToolTip="Apelido visual. Não identifica a conta logada no jogo."/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="NICK · CLIENTE 2" Style="{StaticResource Hint}"/><TextBox x:Name="Nick2" MaxLength="40" Margin="0,6,0,0" ToolTip="Apelido visual. Não identifica a conta logada no jogo."/></StackPanel>
                        <Button Grid.Column="2" Content="Salvar nicks" Click="OnSaveNicks" VerticalAlignment="Bottom"/>
                    </Grid>
                    <TextBlock x:Name="NickStatus" Style="{StaticResource Hint}" Text="Nicks são apenas rótulos. Se trocar de conta na janela, o histórico continua sendo do mesmo cliente." Margin="0,10,0,0"/>
                </StackPanel>
                </Expander>
            </Border>
            <Grid Margin="0,0,12,16">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="Period" SelectionChanged="OnFilterChanged" SelectedIndex="0" Margin="0,0,12,0">
                    <ComboBoxItem Content="Hoje"/><ComboBoxItem Content="Esta sessão"/><ComboBoxItem Content="Últimos 7 dias"/>
                </ComboBox>
                <ComboBox x:Name="Client" Grid.Column="1" SelectionChanged="OnFilterChanged" SelectedIndex="0" Margin="0,0,12,0">
                    <ComboBoxItem Content="Ambos os clientes"/><ComboBoxItem Content="Cliente 1"/><ComboBoxItem Content="Cliente 2"/>
                </ComboBox>
                <Button Grid.Column="2" Content="Atualizar" Click="OnRefresh"/>
            </Grid>
            <UniformGrid Columns="3">
                <Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="OURO CONFIRMADO" Foreground="#F6CE7C" FontSize="11"/><TextBlock x:Name="Gold" Style="{StaticResource StatValue}" Text="—"/><TextBlock x:Name="GoldHint" Style="{StaticResource Hint}" Text="Preços lidos + ação confirmada"/></StackPanel></Border>
                <Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="PROTEÇÕES ACIONADAS" Foreground="#86BCFF" FontSize="11"/><TextBlock x:Name="Emergencies" Style="{StaticResource StatValue}" Text="—"/><TextBlock x:Name="EmergencyHint" Style="{StaticResource Hint}" Text="Incidentes com comando de TP enviado"/></StackPanel></Border>
                <Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="RECOMPENSAS DA GUILDA" Foreground="#BFA7FF" FontSize="11"/><TextBlock x:Name="Rewards" Style="{StaticResource StatValue}" Text="—"/><TextBlock Style="{StaticResource Hint}" Text="Baús coletados, não quantidade de itens"/></StackPanel></Border>
                <Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="BOSS DO AMOR" Foreground="#F1A5CC" FontSize="11"/><TextBlock x:Name="Boss" Style="{StaticResource StatValue}" Text="—"/><TextBlock Style="{StaticResource Hint}" Text="Conclusões observadas no período"/></StackPanel></Border>
                <Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="FARM NA AGENDA" Foreground="#78DFC4" FontSize="11"/><TextBlock x:Name="Farm" Style="{StaticResource StatValue}" Text="—"/><TextBlock Style="{StaticResource Hint}" Text="Tempo contabilizado pelo fluxo da Agenda"/></StackPanel></Border>
                <Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="ROTINAS CONCLUÍDAS" Foreground="#97D6EC" FontSize="11"/><TextBlock x:Name="Routines" Style="{StaticResource StatValue}" Text="—"/><TextBlock Style="{StaticResource Hint}" Text="Diárias e diretivas · sem contar o mesmo ciclo duas vezes"/></StackPanel></Border>
            </UniformGrid>
            <Border Style="{StaticResource StatCard}" Background="#10262E">
                <StackPanel><TextBlock Text="Boss · situação atual" FontWeight="SemiBold" Foreground="#78DFC4"/><TextBlock x:Name="BossProgress" Style="{StaticResource Hint}" Margin="0,10,0,0"/></StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Para onde foi o ouro?" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="GoldBreakdown" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                    <Expander Header="Ver movimentações" Margin="0,14,0,0" Foreground="#D8E5F5">
                        <StackPanel>
                            <TextBlock x:Name="EmptyHistory" Text="Nenhuma movimentação registrada neste período." Style="{StaticResource Hint}" Margin="0,12"/>
                            <ItemsControl x:Name="History">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="#283D52" BorderThickness="0,0,0,1" Padding="0,12">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayTime}" Foreground="#A4B8CE" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayClient}" FontSize="11" Foreground="#65CEFA"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding DisplayValue}" TextWrapping="Wrap" HorizontalAlignment="Right" Foreground="#CBD9E9"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Até 100 movimentações recentes; totais incluem todo o período selecionado." Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
            <TextBlock x:Name="RefreshStatus" Style="{StaticResource Hint}" Margin="0,2,12,8"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,12,18" Text="Cobertura: entradas na T.A/Abadia/Anônima, Loja diária, Artigos e teleporte para Diárias. Valores ilegíveis ou ações não confirmadas ficam fora da soma. A tecla 7 não soma ouro. TP enviado não garante chegada; alerta de HP não prova ataque de jogador. Drops gerais ainda não são contabilizados. Hoje segue a meia-noite do PC; ciclos das rotinas seguem seus próprios resets."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
